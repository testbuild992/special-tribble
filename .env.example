# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# First admin account (created on first run if no users exist)
ADMIN_EMAIL=admin@biji.com
ADMIN_PASSWORD=Biji@1234
ADMIN_NAME=BIJI Admin

# Firebase Firestore (REQUIRED — the app does not run without it)
# Option A (easiest): paste the whole service-account JSON into serviceAccount.json (project root)
# Option B: paste the JSON as a single line below (quotes escaped)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# Option C: the three fields separately
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# WhatsApp Business Cloud API (Meta)
# Leave blank to run in DEV OTP mode (OTP is logged + shown on screen instead of sent)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_message

# Game config
GAME_ANSWER=multi-cuisine
SECOND_COUPON_CORRECT=30
SECOND_COUPON_WRONG=20
COUPON_EXPIRY_DAYS=30
